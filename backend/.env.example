# credenciales del usuario final de la aplicacion
ORACLE_USER=FIDE_CS_APP
ORACLE_PASSWORD=clave_de_fide_cs_app

# alias del tnsnames.ora de la wallet, por ejemplo nombrebd_high
ORACLE_DSN=nombrebd_high

# ruta de la carpeta descomprimida de la wallet y su contrasena
ORACLE_WALLET_DIR=/ruta/a/la/wallet
ORACLE_WALLET_PASSWORD=clave_de_la_wallet

# pool de conexiones
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=5
